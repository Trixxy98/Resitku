# Copy to .env for local development: cp .env.example .env
# In AWS this file does not exist; values are injected into the ECS task
# definition from AWS Secrets Manager and SSM Parameter Store.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Host port 5433 avoids clashing with a PostgreSQL you may already run natively
DATABASE_URL="postgresql://resitku:resitku_local@localhost:5433/resitku?schema=public"
CORS_ORIGIN=http://localhost:5173

# Minimum 32 characters. Generate with: openssl rand -base64 48
# In AWS this comes from Secrets Manager, never from a file.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
