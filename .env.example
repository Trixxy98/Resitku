# Copy to .env for local development: cp .env.example .env
# In AWS this file does not exist; values are injected into the ECS task
# definition from AWS Secrets Manager and SSM Parameter Store.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Host port 5433 avoids clashing with a PostgreSQL you may already run natively
DATABASE_URL="postgresql://resitku:resitku_local@localhost:5433/resitku?schema=public"
CORS_ORIGIN=http://localhost:5173

# Minimum 32 characters. Generate with: openssl rand -base64 48
# In AWS this comes from Secrets Manager, never from a file.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30


# Storan resit setempat (MinIO + ElasticMQ, lihat docker-compose.yml).
# Dalam AWS, S3_ENDPOINT_URL dan SQS_ENDPOINT_URL dibiarkan tidak ditetapkan
# supaya SDK menyasarkan S3/SQS sebenar. AWS_ACCESS_KEY_ID/SECRET_ACCESS_KEY
# di bawah pun tidak wujud dalam produksi — peranan tugas ECS membekalkan
# kredential sebenar secara automatik melalui rantaian lalai SDK.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=resitku
AWS_SECRET_ACCESS_KEY=resitku_local

S3_RECEIPTS_BUCKET=resitku-receipts
S3_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true

SQS_RECEIPTS_QUEUE_URL=http://localhost:9324/000000000000/receipts
SQS_ENDPOINT_URL=http://localhost:9324
